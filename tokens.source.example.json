            "default": { "$value": "{color.on-inverse}", "$type": "color" },
            "disabled": { "$value": "{color.on-inverse-disabled}", "$type": "color" }
          }
        }
      },
      "danger": {
        "fill": {
          "$comment": "Relleno opaco.",
          "background": {
            "default": { "$value": "{color.danger.fill}", "$type": "color" },
