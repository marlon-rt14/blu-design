            "disabled": { "$value": "{color.disabled.on-surface}", "$type": "color" }
          }
        },
        "on-inverse": {
          "$comment": "Sobre una superficie invertida y efímera. Sin bg-default: transparente en reposo.",
          "background": {
            "hover": { "$value": "{color.overlay.on-inverse-hover}", "$type": "color" },
