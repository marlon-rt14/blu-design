            "disabled": { "$value": "{color.disabled.on-surface}", "$type": "color" }
          },
          "icon": {
            "default": { "$value": "{color.role.brand.on-quiet}", "$type": "color" },
            "disabled": { "$value": "{color.disabled.on-surface}", "$type": "color" }
          }
        },
        "ghost": {
          "$comment": "Los MISMOS colores que outline: solo le faltan las claves de borde, porque no lo pinta.",
          "background": {
            "hover": { "$value": "{color.overlay.quiet-hover}", "$type": "color" },
            "pressed": { "$value": "{color.role.brand.quiet-surface-pressed}", "$type": "color" }
          },
          "border": {
            "disabled": { "$value": "{color.disabled.outline}", "$type": "color" }
          },
          "typography": {
            "default": { "$value": "{color.role.brand.on-quiet}", "$type": "color" },
