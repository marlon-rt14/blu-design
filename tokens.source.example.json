            "hover": { "$value": "{color.role.brand.soft-surface-hover}", "$type": "color" },
            "pressed": { "$value": "{color.role.brand.soft-surface-pressed}", "$type": "color" },
            "disabled": { "$value": "{color.disabled.surface}", "$type": "color" }
          },
          "border": {
            "disabled": { "$value": "{color.disabled.outline}", "$type": "color" }
          },
          "typography": {
            "default": { "$value": "{color.role.brand.on-soft}", "$type": "color" },
            "disabled": { "$value": "{color.disabled.on-surface}", "$type": "color" }
          },
          "icon": {
