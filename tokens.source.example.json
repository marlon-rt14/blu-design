          "border": {
            "disabled": { "$value": "{color.disabled.outline}", "$type": "color" }
          },
          "typography": {
            "default": { "$value": "{color.on-fill}", "$type": "color" },
            "disabled": { "$value": "{color.disabled.on-surface}", "$type": "color" }
          },
          "icon": {
            "default": { "$value": "{color.on-fill}", "$type": "color" },
            "disabled": { "$value": "{color.disabled.on-surface}", "$type": "color" }
          }
        },
        "soft": {
          "$comment": "Superficie suave, translúcida en oscuro.",
          "background": {
            "default": { "$value": "{color.danger.soft-surface}", "$type": "color" },
            "hover": { "$value": "{color.danger.soft-surface-hover}", "$type": "color" },
            "pressed": { "$value": "{color.danger.soft-surface-pressed}", "$type": "color" },
            "disabled": { "$value": "{color.disabled.surface}", "$type": "color" }
          },
          "border": {
            "disabled": { "$value": "{color.disabled.outline}", "$type": "color" }
          },
          "typography": {
            "default": { "$value": "{color.danger.on-soft}", "$type": "color" },
            "disabled": { "$value": "{color.disabled.on-surface}", "$type": "color" }
          },
          "icon": {
            "default": { "$value": "{color.danger.on-soft}", "$type": "color" },
            "disabled": { "$value": "{color.disabled.on-surface}", "$type": "color" }
          }
        },
        "outline": {
          "$comment": "Sin relleno en reposo, con borde.",
          "background": {
            "hover": { "$value": "{color.overlay.danger-hover}", "$type": "color" },
            "pressed": { "$value": "{color.danger.quiet-surface-pressed}", "$type": "color" }
          },
          "border": {
            "default": { "$value": "{color.danger.outline}", "$type": "color" },
            "pressed": { "$value": "{color.danger.outline-pressed}", "$type": "color" },
            "disabled": { "$value": "{color.disabled.outline}", "$type": "color" }
