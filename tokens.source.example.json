            "disabled": { "$value": "{color.disabled.on-surface}", "$type": "color" }
          },
          "icon": {
            "default": { "$value": "{color.on-fill}", "$type": "color" },
            "disabled": { "$value": "{color.disabled.on-surface}", "$type": "color" }
          }
        },
        "soft": {
          "$comment": "Superficie suave, translúcida en oscuro.",
          "background": {
